# ─────────────────────────────────────────────────────────────────────────────
# Priority Agent – environment configuration
# Copy to `.env` and fill in. Only the "Required" block is needed for a local demo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────
# Public URL of the app (used for OAuth callbacks, webhook URLs, e-mail links).
# On Vercel it defaults to the project's production domain.
APP_URL=http://localhost:3000

# Auth.js secret – generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# Runtime connection. Recommended: a dedicated NON-OWNER role so PostgreSQL
# Row-Level Security is enforced (see README → "RBAC on the database level").
DATABASE_URL=postgresql://priority_app:priority_app@localhost:5432/priority_agent

# Owner connection used by `prisma migrate` and the seed script.
# Also accepted: DATABASE_URL_UNPOOLED / POSTGRES_URL_NON_POOLING (Vercel Neon integration).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/priority_agent

# Vercel + Neon: the integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED
# for the database OWNER. Set APP_DB_PASSWORD and the app connects through the same
# host as the runtime role APP_DB_USER (default priority_app), which `npm run
# vercel-build` creates – so Row-Level Security is enforced. See docs/NASAZENI-VERCEL-NEON.md.
APP_DB_PASSWORD=
APP_DB_USER=
# Connections per server instance (default 10; 5 on Vercel).
DATABASE_POOL_SIZE=

# 32-byte key (base64) for AES-256-GCM encryption of integration credentials.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me

# ── AI (Anthropic Claude) ───────────────────────────────────────────────────
# Without a key the app runs in "offline AI" mode (deterministic heuristics).
ANTHROPIC_API_KEY=
# Default model for new teams: claude-haiku-5-5 | claude-sonnet-5-5 | claude-opus-5-5
AI_DEFAULT_MODEL=claude-haiku-5-5

# ── Background jobs ─────────────────────────────────────────────────────────
# With REDIS_URL the BullMQ worker (`npm run worker`) processes queues and schedules.
# Without it, jobs run in-process and schedules are triggered via /api/cron/* (Vercel Cron).
REDIS_URL=redis://localhost:6379
# "queue" = BullMQ queues processed by `npm run worker` (needs REDIS_URL); otherwise jobs run in-process.
JOB_RUNNER=
# "false" disables the in-process scheduler (it is always off on Vercel; use cron → /api/cron/*).
INTERNAL_SCHEDULER=
# Protects /api/cron/* endpoints (Vercel sends it as `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=change-me

# Live updates in the browser: "sse" (server-sent events) or "poll" (periodic refresh).
# Default: poll on Vercel, sse elsewhere. SSE across several instances needs REDIS_URL.
REALTIME_TRANSPORT=

# ── Deployment (`npm run vercel-build`) ─────────────────────────────────────
# "true" = load the demo data during the build, but only into an empty database.
SEED_DEMO_DATA=
# Database setup during the build: auto (skipped for preview deployments) | always | never
DB_SETUP=
# Emergency switch: start even if PostgreSQL would not enforce RLS for the app's role.
ALLOW_RLS_BYPASS=

# ── E-mail notifications (SMTP) ─────────────────────────────────────────────
# Leave SMTP_HOST empty to log e-mails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Priority Agent <noreply@example.com>"

# ── Web push (generate with `npm run vapid`) ────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Google: Gmail + Google Calendar (+ optional SSO login) ──────────────────
# OAuth redirect URIs to register:
#   {APP_URL}/api/integrations/google/callback   (mailbox + calendar connection)
#   {APP_URL}/api/auth/callback/google            (optional SSO login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft 365: Outlook mail + calendar (+ optional SSO login) ───────────
#   {APP_URL}/api/integrations/microsoft/callback
#   {APP_URL}/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── WhatsApp Business Cloud API (webhook: {APP_URL}/api/webhooks/whatsapp) ──
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# ── SMS via Twilio (optional; webhook: {APP_URL}/api/webhooks/sms) ──────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Embedding (optional) ────────────────────────────────────────────────────
# Allow embedding in an iframe (CSP frame-ancestors), e.g. "'self' https://intranet.example.com".
CSP_FRAME_ANCESTORS=
# "true" = auth cookies with SameSite=None; Secure; Partitioned (needed inside cross-site iframes, HTTPS only).
AUTH_COOKIE_SAMESITE_NONE=

# ── Misc ────────────────────────────────────────────────────────────────────
# Show demo accounts on the login page.
DEMO_MODE=true
# IANA timezone used for briefings, "today" calculations and quiet hours.
NEXT_PUBLIC_APP_TIMEZONE=Europe/Prague
